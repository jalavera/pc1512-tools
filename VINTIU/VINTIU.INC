; VINTIU.INC - bitmaps per a VINTIU.ASM (generat amb gen_inc.py)
; Pals: format estandard GEM (bit 15 = pixel de l'esquerra); a l'inici es
; converteixen al format del dispositiu amb vr_trnfm. Index a bmtab:
;   mida*4 + pal (mida 0 petit, 1 mitja, 2 gran; pal 0 piques, 1 cors,
;   2 trevols, 3 diamants)
; Figures (0..11 = J, Q, K de cada pal) i ornament de l'as (12): imatges de
; 5 colors comprimides per tirades; es descomprimeixen quan es dibuixen.
;   simbols: 0 blanc, 1 vermell, 2 blau, 3 or, 4 negre, 5 = com a sobre
;   byte = simbol*32 + llarg-1 (1..31); si llarg-1 = 31, el byte seguent
;   + 32 es la llargada. figtab: dades, amplada, alcada.

FIG_MAXW  equ 104
FIG_MAXH  equ 64
FIG_MAXWD equ 7              ; paraules per linia, maxim

bmtab:  dw dv_pica_S, dv_cor_S, dv_trevol_S, dv_diamant_S, dv_pica_M, dv_cor_M, dv_trevol_M, dv_diamant_M, dv_pica_L, dv_cor_L, dv_trevol_L, dv_diamant_L
bmlist: dw st_pica_S, dv_pica_S, st_cor_S, dv_cor_S, st_trevol_S, dv_trevol_S, st_diamant_S, dv_diamant_S, st_pica_M, dv_pica_M, st_cor_M, dv_cor_M, st_trevol_M, dv_trevol_M, st_diamant_M, dv_diamant_M, st_pica_L, dv_pica_L, st_cor_L, dv_cor_L, st_trevol_L, dv_trevol_L, st_diamant_L, dv_diamant_L, 0
