; SOLITARI.INC - bitmaps per a SOLITARI.ASM (generat amb gen_sol_inc.py)
; Pals: format estandard GEM (bit 15 = pixel de l'esquerra); a l'inici es
; converteixen al format del dispositiu amb vr_trnfm. Index a bmtab:
;   mida*4 + pal (mida 0 petit 13x6, 1 gran 30x13; pal 0 piques, 1 cors,
;   2 trevols, 3 diamants)
; Figures (0..11 = J, Q, K de cada pal): imatges de 5 colors comprimides
; per tirades; es descomprimeixen quan es dibuixen.
;   simbols: 0 blanc, 1 vermell, 2 blau, 3 or, 4 negre, 5 = com a sobre
;   byte = simbol*32 + llarg-1 (1..31); si llarg-1 = 31, el byte seguent
;   + 32 es la llargada. figtab: dades, amplada, alcada.

FIG_MAXW  equ 44
FIG_MAXH  equ 32
FIG_MAXWD equ 3

bmtab:  dw dv_pica_S, dv_cor_S, dv_trevol_S, dv_diamant_S, dv_pica_L, dv_cor_L, dv_trevol_L, dv_diamant_L
bmlist: dw st_pica_S, dv_pica_S, st_cor_S, dv_cor_S, st_trevol_S, dv_trevol_S, st_diamant_S, dv_diamant_S, st_pica_L, dv_pica_L, st_cor_L, dv_cor_L, st_trevol_L, dv_trevol_L, st_diamant_L, dv_diamant_L, 0
figtab: dw fg_J_piques, 44, 32, fg_J_cors, 44, 32, fg_J_trevols, 44, 32, fg_J_diamants, 44, 32, fg_Q_piques, 44, 32, fg_Q_cors, 44, 32, fg_Q_trevols, 44, 32, fg_Q_diamants, 44, 32, fg_K_piques, 44, 32, fg_K_cors, 44, 32, fg_K_trevols, 44, 32, fg_K_diamants, 44, 32

